# ==================== Docker 构建忽略文件 ====================
# 排除不需要进入镜像的文件

# Git
.git
.gitignore
.gitattributes

# IDE
.idea
.vscode
*.iml
*.iws
*.ipr
.settings
.project
.classpath

# Maven（target/ 匹配根级，**/target 匹配多模块子目录）
target/
**/target/
!.mvn/wrapper/maven-wrapper.jar

# 上传目录（运行时挂载卷）
uploads/

# 日志
logs/
*.log

# 环境配置
.env
.env.*
!.env.example

# 文档
*.md
README.md
LICENSE

# 前端（单独部署）
frontend/

# Docker
Dockerfile
docker-compose*.yml
.dockerignore

# 系统文件
.DS_Store
Thumbs.db

# 临时文件
*.tmp
*.bak
*.swp
.idea/
