# ==================== 环境变量配置示例 ====================
# 用法：cp .env.example .env，然后把下面的占位符替换为真实值
# 注意：.env 不进入 Git，真实密钥只放在 .env

# ---------- LLM 配置（OpenAI 兼容 API） ----------
# 切换 LLM 只改这三项；compose 中以 ${VLLM_API_KEY} 形式引用，禁止把真实 Key 写入 compose
# Kimi 示例：VLLM_BASE_URL=https://api.moonshot.cn/v1  VLLM_MODEL=kimi-k2.6
# DeepSeek 示例：VLLM_BASE_URL=https://api.deepseek.com/v1  VLLM_MODEL=deepseek-chat
# SiliconFlow 示例：VLLM_BASE_URL=https://api.siliconflow.cn/v1  VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
VLLM_BASE_URL=https://api.moonshot.cn/v1
VLLM_MODEL=kimi-k2.6
VLLM_API_KEY=sk-your-llm-api-key-here

# ---------- MySQL 配置 ----------
MYSQL_ROOT_PASSWORD=your-mysql-root-password-here

# ---------- JWT 密钥 ----------
# auth-service 与 gateway 必须使用同一密钥（签名/验签一致）
# 生成方式：openssl rand -base64 48
JWT_SECRET=your-jwt-secret-here

# ---------- 日志级别: debug, info, warn, error ----------
LOG_LEVEL=info

# ---------- 时区 ----------
TZ=Asia/Shanghai
